# Application Environment (development, staging, production)
APP_ENV=development

# Database Configuration (SQLite for simplicity)
DATABASE_URL=sqlite+aiosqlite:///./personal_assistant.db

# Redis Configuration (optional for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Options: openai, groq, anthropic, local
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Groq Configuration (alternative fast LLM provider)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Configuration (for RAG)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/api/v1/telegram/webhook

# MCP Configuration
MCP_CONFIG_PATH=/app/mcp_config.json

# Logging
LOG_LEVEL=INFO
